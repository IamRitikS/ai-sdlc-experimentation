# ── LLM Providers ──────────────────────────────────────────────
# zllama (some self hosted endpoint) — primary provider
ZLLAMA_API_KEY=
ZLLAMA_BASE_URL=https://zllama.corp.zscaler.com/v1/

# Optional fallback providers (leave blank if unused)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Per-agent model config ──────────────────────────────────────
# Supported providers: zllama, openai, anthropic
# Set <AGENT>_MODEL to whichever model name zllama exposes.
DESIGNER_PROVIDER=zllama
DESIGNER_MODEL=gpt-5.4

SUPERVISOR_PROVIDER=zllama
SUPERVISOR_MODEL=gpt-5.4

BACKEND_PROVIDER=zllama
BACKEND_MODEL=claude-sonnet-4-6

FRONTEND_PROVIDER=zllama
FRONTEND_MODEL=claude-sonnet-4-6

DATABASE_PROVIDER=zllama
DATABASE_MODEL=gpt-5.4

INTEGRATOR_PROVIDER=zllama
INTEGRATOR_MODEL=gpt-5.4

QA_PROVIDER=zllama
QA_MODEL=claude-sonnet-4-5

REVIEW_PROVIDER=zllama
REVIEW_MODEL=claude-opus-4-7

DOCS_PROVIDER=zllama
DOCS_MODEL=gpt-5.4-mini

DEPLOY_PROVIDER=zllama
DEPLOY_MODEL=gpt-5.4-mini

# ── SDLC Config ─────────────────────────────────────────────────
# Directory where agents write generated project files
OUTPUT_DIR=./output

# Max feedback loop iterations before forcing human escalation
MAX_ITER=3

# Confidence threshold below which HITL is triggered (0.0–1.0)
CONFIDENCE_THRESHOLD=0.7

# SQLite checkpoint DB path (use :memory: for ephemeral)
CHECKPOINT_DB=./sdlc_checkpoints.db
